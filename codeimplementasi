
import tkinter as tk
from tkinter import ttk, messagebox
from matplotlib.figure import Figure
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg
from matplotlib_venn import venn2


class SistemHimpunan:
    def __init__(self, root):
        self.root = root
        self.root.title("Sistem Klasifikasi Data dengan Himpunan")
        self.root.geometry("1050x750")

        self.A = set()
        self.B = set()
        self.U = set()

        self.buat_tampilan()

    def buat_tampilan(self):
        judul = ttk.Label(
            self.root,
            text="SISTEM KLASIFIKASI DATA DENGAN HIMPUNAN",
            font=("Arial", 16, "bold")
        )
        judul.pack(pady=12)

        frame_input = ttk.LabelFrame(
            self.root, text="Input Dataset", padding=10
        )
        frame_input.pack(fill="x", padx=15, pady=5)

        ttk.Label(frame_input, text="Dataset A:").grid(
            row=0, column=0, sticky="w"
        )
        self.input_A = tk.Text(frame_input, height=4, width=38)
        self.input_A.grid(row=1, column=0, padx=5, pady=5)

        ttk.Label(frame_input, text="Dataset B:").grid(
            row=0, column=1, sticky="w"
        )
        self.input_B = tk.Text(frame_input, height=4, width=38)
        self.input_B.grid(row=1, column=1, padx=5, pady=5)

        ttk.Label(
            frame_input,
            text="Semesta (U), opsional:"
        ).grid(row=0, column=2, sticky="w")

        self.input_U = tk.Text(frame_input, height=4, width=38)
        self.input_U.grid(row=1, column=2, padx=5, pady=5)

        ttk.Button(
            frame_input,
            text="Proses Dataset",
            command=self.proses
        ).grid(row=2, column=0, columnspan=3, pady=10)

        frame_operasi = ttk.LabelFrame(
            self.root, text="Operasi Himpunan", padding=10
        )
        frame_operasi.pack(fill="x", padx=15, pady=5)

        tombol = [
            ("Union (A ∪ B)", self.union),
            ("Intersection (A ∩ B)", self.intersection),
            ("Difference (A - B)", self.difference),
            ("Complement A", self.complement_A),
            ("Complement B", self.complement_B),
            ("Diagram Venn + PIE", self.venn_pie)
        ]

        for i, (nama, fungsi) in enumerate(tombol):
            ttk.Button(
                frame_operasi,
                text=nama,
                command=fungsi
            ).grid(
                row=i // 3,
                column=i % 3,
                padx=10,
                pady=7,
                sticky="ew"
            )

        for i in range(3):
            frame_operasi.columnconfigure(i, weight=1)

        frame_hasil = ttk.LabelFrame(
            self.root, text="Hasil Pengolahan Data", padding=10
        )
        frame_hasil.pack(fill="both", expand=True, padx=15, pady=5)

        self.hasil = tk.Text(
            frame_hasil,
            height=9,
            font=("Consolas", 10),
            wrap="word"
        )
        self.hasil.pack(fill="both", expand=True)

        self.frame_grafik = ttk.LabelFrame(
            self.root, text="Visualisasi Diagram Venn", padding=5
        )
        self.frame_grafik.pack(fill="both", expand=True, padx=15, pady=5)

        self.canvas_widget = None

    def baca_data(self, widget):
        teks = widget.get("1.0", tk.END)
        data = teks.replace("\n", ",").split(",")
        return {x.strip() for x in data if x.strip()}

    def tampilkan(self, teks):
        self.hasil.delete("1.0", tk.END)
        self.hasil.insert(tk.END, teks)

    def proses(self):
        self.A = self.baca_data(self.input_A)
        self.B = self.baca_data(self.input_B)

        semesta_teks = self.input_U.get("1.0", tk.END).strip()

        if semesta_teks:
            self.U = self.baca_data(self.input_U)
            if not self.A.issubset(self.U) or not self.B.issubset(self.U):
                messagebox.showerror(
                    "Kesalahan",
                    "Semua anggota A dan B harus termasuk dalam semesta U."
                )
                return
        else:
            self.U = self.A | self.B

        if not self.A and not self.B:
            messagebox.showwarning(
                "Peringatan", "Masukkan minimal satu dataset."
            )
            return

        self.tampilkan(
            "DATASET BERHASIL DIPROSES\n\n"
            f"Dataset A = {sorted(self.A)}\n"
            f"Dataset B = {sorted(self.B)}\n"
            f"Semesta U = {sorted(self.U)}\n\n"
            f"Jumlah anggota A = {len(self.A)}\n"
            f"Jumlah anggota B = {len(self.B)}\n"
            f"Jumlah semesta U = {len(self.U)}\n"
        )

    def cek_data(self):
        if not self.U and not self.A and not self.B:
            messagebox.showwarning(
                "Peringatan", "Proses dataset terlebih dahulu."
            )
            return False
        return True

    def union(self):
        if not self.cek_data():
            return
        hasil = self.A | self.B
        self.tampilkan(
            "OPERASI UNION (A ∪ B)\n\n"
            "Menggabungkan semua anggota A dan B "
            "tanpa duplikasi.\n\n"
            f"Hasil = {sorted(hasil)}\n"
            f"Jumlah data unik = {len(hasil)}"
        )

    def intersection(self):
        if not self.cek_data():
            return
        hasil = self.A & self.B
        self.tampilkan(
            "OPERASI INTERSECTION (A ∩ B)\n\n"
            "Menampilkan anggota yang terdapat pada "
            "kedua dataset.\n\n"
            f"Hasil = {sorted(hasil)}\n"
            f"Jumlah anggota yang sama = {len(hasil)}"
        )

    def difference(self):
        if not self.cek_data():
            return

        a_b = self.A - self.B
        b_a = self.B - self.A

        self.tampilkan(
            "OPERASI DIFFERENCE\n\n"
            "A - B: Anggota A yang tidak ada di B.\n"
            f"Hasil A - B = {sorted(a_b)}\n\n"
            "B - A: Anggota B yang tidak ada di A.\n"
            f"Hasil B - A = {sorted(b_a)}"
        )

    def complement_A(self):
        if not self.cek_data():
            return
        hasil = self.U - self.A
        self.tampilkan(
            "COMPLEMENT A (Aᶜ)\n\n"
            "Anggota semesta yang tidak terdapat "
            "dalam A.\n\n"
            f"Hasil = {sorted(hasil)}\n"
            f"Jumlah = {len(hasil)}"
        )

    def complement_B(self):
        if not self.cek_data():
            return
        hasil = self.U - self.B
        self.tampilkan(
            "COMPLEMENT B (Bᶜ)\n\n"
            "Anggota semesta yang tidak terdapat "
            "dalam B.\n\n"
            f"Hasil = {sorted(hasil)}\n"
            f"Jumlah = {len(hasil)}"
        )

    def venn_pie(self):
        if not self.cek_data():
            return

        gabungan = self.A | self.B
        irisan = self.A & self.B

        nA = len(self.A)
        nB = len(self.B)
        nAB = len(irisan)

        # Prinsip Inklusi-Eksklusi
        pie = nA + nB - nAB

        if pie != len(gabungan):
            messagebox.showerror(
                "Kesalahan", "Perhitungan PIE tidak sesuai."
            )
            return

        # Hapus grafik sebelumnya
        if self.canvas_widget:
            self.canvas_widget.get_tk_widget().destroy()

        fig = Figure(figsize=(6, 3.5), dpi=100)
        ax = fig.add_subplot(111)

        venn2(
            subsets=(
                len(self.A - self.B),
                len(self.B - self.A),
                len(irisan)
            ),
            set_labels=("Dataset A", "Dataset B"),
            ax=ax
        )

        ax.set_title("Diagram Venn Dataset A dan B")

        self.canvas_widget = FigureCanvasTkAgg(
            fig, master=self.frame_grafik
        )
        self.canvas_widget.draw()
        self.canvas_widget.get_tk_widget().pack(
            fill="both", expand=True
        )

        self.tampilkan(
            "PRINSIP INKLUSI-EKSKLUSI (PIE)\n\n"
            "Rumus:\n"
            "|A ∪ B| = |A| + |B| - |A ∩ B|\n\n"
            f"|A| = {nA}\n"
            f"|B| = {nB}\n"
            f"|A ∩ B| = {nAB}\n\n"
            f"|A ∪ B| = {nA} + {nB} - {nAB}\n"
            f"|A ∪ B| = {pie}\n\n"
            f"Jumlah data unik = {len(gabungan)}\n"
            f"Anggota gabungan = {sorted(gabungan)}\n\n"
            "Kesimpulan: Perhitungan PIE sesuai "
            "dengan jumlah anggota gabungan."
        )


if __name__ == "__main__":
    root = tk.Tk()
    app = SistemHimpunan(root)
    root.mainloop()
